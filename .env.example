# CineVee — variáveis de ambiente (Etapa 24).
# Copie para `.env` e preencha. `.env`, `.env.local` e `.env.production`
# NUNCA entram no git (ver .gitignore). Sem valores reais aqui.

# TMDB (server-only — nunca use prefixo PUBLIC_)
TMDB_ACCESS_TOKEN=

# IA — Groq primário (server-only)
GROQ_API_KEY=
# Modelo Groq (opcional; default no código: qwen/qwen3.8-27b)
GROQ_MODEL=

# IA — Gemini fallback (server-only)
GEMINI_API_KEY=
# Modelo Gemini (opcional; default no código: gemini-3.8-flash)
GEMINI_MODEL=

# Supabase Auth (fundação — somente chave publishable, nunca service_role)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site (opcional em dev; OBRIGATÓRIA em produção para
# canonical/OpenGraph absolutos — Etapa 25 define o domínio real)
PUBLIC_SITE_URL=
