---
/**
 * DiscoveryProgress — topo do questionário: voltar, contador, recomeçar
 * e barra de progresso fina e discreta (1–5). Mesmos hooks e comportamento;
 * apenas visual. A escolha inicial não conta: contador oculto, barra zerada.
 */
import DiscoveryIcon from "./DiscoveryIcon.astro";
---

<div>
  <div class="flex min-h-12 items-center justify-between gap-2">
    <div class="flex min-h-12 items-center gap-3">
      <button
        type="button"
        data-discovery-back
        aria-label="Voltar à pergunta anterior"
        class="flex min-h-12 min-w-12 items-center justify-center rounded-full border border-base-300 text-base-content/70 transition-colors duration-200 hover:bg-base-200"
      >
        <svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5" />
          <path d="M12 19l-7-7 7-7" />
        </svg>
      </button>
      <p data-progress-count class="text-sm font-semibold tracking-wide text-base-content/60"></p>
    </div>
    <button
      type="button"
      data-discovery-restart
      class="flex min-h-12 items-center gap-1.5 rounded-full border border-base-300/60 bg-base-200/40 py-2 pl-3 pr-4 text-xs font-medium text-base-content/55 transition-colors duration-200 hover:border-base-content/25 hover:bg-base-200/70 hover:text-base-content"
    >
      <DiscoveryIcon name="refresh" class="discovery-icon--sm" />
      Recomeçar
    </button>
  </div>

  <div
    data-progress-bar
    role="progressbar"
    aria-label="Progresso do questionário"
    aria-valuemin={0}
    aria-valuemax={5}
    aria-valuenow={0}
    class="mt-2 h-1 overflow-visible rounded-full bg-base-300/70"
  >
    <div
      data-progress-fill
      class="discovery-progress-fill h-full rounded-full bg-primary transition-all duration-300"
      style="width: 0%"
    />
  </div>
</div>
