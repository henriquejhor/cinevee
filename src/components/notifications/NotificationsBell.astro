---
/**
 * Sino de notificações (Etapa 21). Discreto, no AppHeader.
 * Home continua prerendered: o estado resolve client-side via
 * GET /api/notifications/unread-count (401 = anon, sino oculto).
 * Clique vai para /notificacoes (sem dropdown nesta etapa).
 * Badge sincroniza via CustomEvent cinevee:notifications-updated.
 */
---

<a
  id="notifications-bell"
  href="/notificacoes"
  style="display: none"
  class="relative inline-flex min-h-12 min-w-12 items-center justify-center rounded-full px-3 text-base-content/70 hover:bg-base-200 hover:text-base-content"
  aria-label="Notificações"
>
  <svg
    aria-hidden="true"
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
    <path d="M13.7 21a2 2 0 0 1-3.4 0" />
  </svg>
  <span
    id="notifications-badge"
    aria-hidden="true"
    style="display: none"
    class="absolute right-1 top-1 inline-flex min-h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1 text-[11px] font-bold tabular-nums text-primary-content"
  ></span>
</a>

<script>
  // Sino: 1 request pequeno por navegação (sem polling/Realtime).
  (function () {
    var bell = document.getElementById("notifications-bell") as HTMLElement | null;
    var badge = document.getElementById("notifications-badge") as HTMLElement | null;
    if (!bell || !badge) return;

    function paint(unread: number) {
      if (!bell || !badge) return;
      var count = Number.isSafeInteger(unread) && unread > 0 ? unread : 0;
      bell.style.display = "";
      if (count <= 0) {
        badge.style.display = "none";
        badge.textContent = "";
        bell.setAttribute("aria-label", "Notificações");
      } else {
        badge.style.display = "";
        badge.textContent = count > 99 ? "99+" : String(count);
        bell.setAttribute("aria-label", "Notificações, " + count + " não lidas");
      }
    }

    fetch("/api/notifications/unread-count", { credentials: "same-origin" })
      .then(function (res) {
        if (!res.ok) return null;
        return res.json();
      })
      .then(function (data: unknown) {
        if (!data || typeof data !== "object") return;
        var unread = (data as Record<string, unknown>).unreadCount;
        if (typeof unread !== "number" || !Number.isSafeInteger(unread) || unread < 0) return;
        paint(unread);
      })
      .catch(function () {
        // 401 (anon) ou falha: sino permanece oculto.
      });

    document.addEventListener("cinevee:notifications-updated", function (event) {
      var detail = (event as CustomEvent).detail as Record<string, unknown> | null;
      var unread = detail ? detail.unreadCount : 0;
      if (typeof unread === "number") paint(unread);
    });
  })();
</script>
