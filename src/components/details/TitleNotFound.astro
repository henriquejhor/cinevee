---
/**
 * Estado de erro da página de detalhes: ID inexistente (404) ou falha
 * temporária. Mensagem amigável + link para a Home. Sem stack trace.
 */

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = "Não encontramos este título.",
  text = "O conteúdo pode ter sido removido ou o endereço está incorreto.",
} = Astro.props;
---

<div class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-32 pt-14 text-center">
  <h1 class="max-w-[20ch] text-balance text-3xl font-extrabold tracking-tight">
    {heading}
  </h1>
  <p class="mt-3 max-w-[42ch] text-pretty text-base text-base-content/70">{text}</p>
  <a href="/" class="btn btn-primary mt-6 h-12 min-h-12 rounded-full px-8">
    Voltar para a Home
  </a>
</div>
