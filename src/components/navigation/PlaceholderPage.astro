---
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import AppHeader from "./AppHeader.astro";

interface Props {
  title: string;
  heading: string;
  text: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const { title, heading, text, ctaHref, ctaLabel } = Astro.props;
---

<Layout title={title}>
  <AppHeader />
  <main class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 pb-32 pt-14 text-center">
    <h1 class="max-w-[20ch] text-balance text-3xl font-extrabold tracking-tight">{heading}</h1>
    <p class="mt-3 max-w-[42ch] text-pretty text-base text-base-content/70">{text}</p>
    {
      ctaHref && ctaLabel && (
        <a href={ctaHref} class="btn btn-primary mt-6 h-12 min-h-12 rounded-full px-8">
          {ctaLabel}
        </a>
      )
    }
  </main>
</Layout>
