---
/**
 * Botão "Continuar com Google" + separador "ou" (usado em /entrar e /cadastrar).
 *
 * - Inicia `supabase.auth.signInWithOAuth({ provider: "google" })` no browser
 *   (browser client @supabase/ssr — o caso "futuro pontual" previsto em
 *   `lib/supabase/client.ts`). Sucesso = redirecionamento ao Google, sem POST
 *   (checkOrigin/CSRF preservados).
 * - `redirectTo`: PUBLIC_SITE_URL em produção, origem local em dev
 *   (nada hardcodado), sempre terminando em /auth/callback com `?next=`
 *   preservado (já sanitizado pela página).
 * - Identidade básica do Google, sem scopes extras, sem provider_token,
 *   sem localStorage (sessão só em cookies via callback server-side).
 * - Loading desabilita o botão (evita clique duplo); falha mostra erro
 *   genérico no bloco próprio, sem expor detalhes.
 */
interface Props {
  next: string;
}

const { next } = Astro.props;
---

<div class="mt-6">
  <button
    id="google-oauth-btn"
    type="button"
    data-next={next}
    class="btn btn-outline min-h-12 w-full gap-2.5 rounded-full text-base font-semibold"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="#4285F4"
        d="M23.5 12.3c0-.9-.1-1.5-.3-2.3H12v4.5h6.5c-.1 1.1-.8 2.7-2.4 3.8l-.1.1 3.5 2.7.2.1c2.2-2 3.6-5 3.6-8.9z"
      ></path>
      <path
        fill="#34A853"
        d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.8-2.9c-1 .7-2.4 1.2-4.1 1.2-3.1 0-5.8-2.1-6.8-5l-.1.1-3.6 2.8v.1C3.5 21.3 7.4 24 12 24z"
      ></path>
      <path
        fill="#FBBC05"
        d="M5.2 14.4c-.2-.7-.4-1.5-.4-2.4s.1-1.7.4-2.4l-.1-.1-3.6-2.8-.1.1C.5 8.7 0 10.2 0 12s.5 3.3 1.4 4.8l3.8-2.4z"
      ></path>
      <path
        fill="#EA4335"
        d="M12 4.7c1.8 0 3 .8 3.7 1.4l3.3-3.2C17.9 1.1 15.2 0 12 0 7.4 0 3.5 2.7 1.4 6.8l3.8 2.9c1-2.9 3.7-5 6.8-5z"
      ></path>
    </svg>
    <span data-google-label>Continuar com Google</span>
  </button>
  <p
    id="google-oauth-error"
    role="alert"
    style="display: none"
    class="mt-3 rounded-2xl border border-error/40 bg-error/10 px-4 py-3 text-sm"
  ></p>
  <div class="mt-4 flex items-center gap-3" aria-hidden="true">
    <span class="h-px flex-1 bg-base-300"></span>
    <span class="text-xs font-medium text-base-content/50">ou</span>
    <span class="h-px flex-1 bg-base-300"></span>
  </div>
</div>

<script>
  import { createSupabaseBrowserClient } from "../../lib/supabase/client";

  (function () {
    var raw = document.getElementById("google-oauth-btn");
    if (!(raw instanceof HTMLButtonElement)) return;
    const btn = raw;
    var label = btn.querySelector("[data-google-label]");
    var errorBox = document.getElementById("google-oauth-error");

    function fail() {
      btn.disabled = false;
      if (label) label.textContent = "Continuar com Google";
      if (errorBox) {
        errorBox.textContent = "Não foi possível entrar com o Google. Tente de novo.";
        errorBox.style.display = "";
      }
    }

    btn.addEventListener("click", function () {
      if (btn.disabled) return;
      btn.disabled = true;
      if (label) label.textContent = "Conectando ao Google…";
      if (errorBox) errorBox.style.display = "none";

      var siteUrl = ((import.meta.env.PUBLIC_SITE_URL as string | undefined) ?? "")
        .trim()
        .replace(/\/+$/, "");
      var baseUrl = siteUrl || window.location.origin;
      var next = btn.getAttribute("data-next") || "/perfil";

      var redirectTo = baseUrl + "/auth/callback?next=" + encodeURIComponent(next);

      try {
        createSupabaseBrowserClient()
          .auth.signInWithOAuth({
            provider: "google",
            options: { redirectTo: redirectTo },
          })
          .then(function (result) {
            if (result.error) fail();
            // Sucesso: o Supabase redireciona o navegador ao Google.
          })
          .catch(fail);
      } catch {
        fail();
      }
    });
  })();
</script>
