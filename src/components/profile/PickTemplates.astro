---
/**
 * PickTemplates — <template>s clonados pelo JavaScript de /perfil/sobre.
 *
 * - #pick-search-result-template: linha do dialog de busca;
 * - #favorite-card-template: card do grid de favoritos;
 * - #recommendation-row-template: linha da lista Recomendo.
 *
 * Os valores reais são preenchidos via textContent/atributos (nunca
 * via innerHTML) — nota e títulos são texto puro escapado.
 */
---

<template id="pick-search-result-template">
  <li class="flex items-center gap-3 rounded-2xl p-2 hover:bg-base-200/60">
    <div
      data-role="poster"
      class="cinevee-poster relative w-14 shrink-0"
      aria-hidden="true"
    >
      <svg
        aria-hidden="true"
        class="absolute inset-0 m-auto h-5 w-5 text-white/25"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M12 2.5 14.3 9l6.7.1-5.4 4 2 6.5-5.6-3.9-5.6 3.9 2-6.5-5.4-4 6.7-.1L12 2.5Z" />
      </svg>
      <img
        data-role="img"
        alt=""
        width="342"
        height="513"
        loading="lazy"
        class="absolute inset-0 h-full w-full rounded-[0.75rem] object-cover"
        hidden
      />
    </div>
    <div class="min-w-0 flex-1 py-1">
      <p data-role="title" class="truncate text-sm font-semibold leading-snug"></p>
      <p data-role="meta" class="mt-0.5 text-xs text-base-content/60"></p>
    </div>
    <button
      data-role="action"
      type="button"
      class="btn btn-primary btn-sm min-h-12 shrink-0 rounded-full px-4 text-xs font-semibold"
    >
      Adicionar
    </button>
  </li>
</template>

<template id="favorite-card-template">
  <li data-pick-card data-kind="favorite" data-pick-id="" data-tmdb-id="" data-media-type="" data-position="">
    <article class="relative">
      <a
        data-role="link"
        href="#"
        class="cinevee-card group block rounded-xl"
      >
        <img
          data-role="poster"
          alt=""
          width="500"
          height="750"
          loading="lazy"
          class="aspect-[2/3] w-full rounded-xl border border-white/10 object-cover"
          hidden
        />
        <div data-role="placeholder" class="cinevee-poster flex items-center justify-center" aria-hidden="true">
          <svg
            aria-hidden="true"
            class="h-10 w-10 text-white/25"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 2.5 14.3 9l6.7.1-5.4 4 2 6.5-5.6-3.9-5.6 3.9 2-6.5-5.4-4 6.7-.1L12 2.5Z" />
          </svg>
        </div>
        <p data-role="title" class="mt-2 truncate px-0.5 text-sm font-medium leading-snug text-base-content group-hover:text-primary"></p>
        <p data-role="meta" class="mt-0.5 px-0.5 text-xs text-base-content/60"></p>
      </a>
      <button
        data-pick-remove
        type="button"
        class="absolute right-1.5 top-1.5 flex min-h-12 min-w-12 items-center justify-center rounded-full border border-white/15 bg-black/55 text-red-300/90 backdrop-blur-sm transition-colors duration-200 hover:border-red-800/50 hover:bg-red-950/70 hover:text-red-200"
      >
        <svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 7h16" />
          <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
          <path d="M6.5 7l1 13h9l1-13" />
        </svg>
      </button>
      <div class="mt-1 flex items-center gap-1" data-role="reorder">
        <button
          data-pick-up
          type="button"
          aria-label="Mover para cima"
          class="btn btn-ghost btn-sm min-h-12 min-w-12 rounded-xl px-2"
        >
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 15-6-6-6 6" />
          </svg>
        </button>
        <button
          data-pick-down
          type="button"
          aria-label="Mover para baixo"
          class="btn btn-ghost btn-sm min-h-12 min-w-12 rounded-xl px-2"
        >
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
      </div>
    </article>
  </li>
</template>

<template id="recommendation-row-template">
  <li data-pick-card data-kind="recommendation" data-pick-id="" data-tmdb-id="" data-media-type="" data-position="">
    <article class="flex gap-3 rounded-2xl border border-base-300/60 bg-base-200/40 p-3">
      <a data-role="poster-link" href="#" class="block w-16 shrink-0 sm:w-20" tabindex="-1" aria-hidden="true">
        <img
          data-role="poster"
          alt=""
          width="500"
          height="750"
          loading="lazy"
          class="aspect-[2/3] w-full rounded-xl border border-white/10 object-cover"
          hidden
        />
        <div data-role="placeholder" class="cinevee-poster flex items-center justify-center" aria-hidden="true">
          <svg
            aria-hidden="true"
            class="h-8 w-8 text-white/25"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 2.5 14.3 9l6.7.1-5.4 4 2 6.5-5.6-3.9-5.6 3.9 2-6.5-5.4-4 6.7-.1L12 2.5Z" />
          </svg>
        </div>
      </a>
      <div class="min-w-0 flex-1">
        <a data-role="title-link" href="#" class="cinevee-card group inline-block max-w-full rounded-lg">
          <p data-role="title" class="truncate text-sm font-semibold leading-snug group-hover:text-primary"></p>
        </a>
        <p data-role="meta" class="mt-0.5 text-xs text-base-content/60"></p>
        <p data-role="note" class="cinevee-review-text mt-2 text-sm leading-6 text-base-content/80"></p>
        <div class="mt-2 flex flex-wrap items-center gap-1">
          <button
            data-pick-edit-note
            type="button"
            class="inline-flex min-h-12 items-center rounded-lg px-2 text-xs font-semibold text-base-content/70 underline-offset-4 hover:text-base-content hover:underline"
          >
            Editar
          </button>
          <button
            data-pick-remove
            type="button"
            class="inline-flex min-h-12 items-center rounded-lg px-2 text-xs font-medium text-error/80 underline-offset-4 hover:text-error hover:underline"
          >
            Remover
          </button>
          <span class="min-w-2 flex-1" aria-hidden="true"></span>
          <button
            data-pick-up
            type="button"
            aria-label="Mover para cima"
            class="btn btn-ghost btn-sm min-h-12 min-w-12 rounded-xl px-2"
          >
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m18 15-6-6-6 6" />
            </svg>
          </button>
          <button
            data-pick-down
            type="button"
            aria-label="Mover para baixo"
            class="btn btn-ghost btn-sm min-h-12 min-w-12 rounded-xl px-2"
          >
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </button>
        </div>
      </div>
    </article>
  </li>
</template>
