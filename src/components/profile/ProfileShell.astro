---
/**
 * Shell compartilhado do perfil — /perfil e /perfil/lista usam o MESMO
 * hero/avatar/identidade/stats/tabs (sem duplicação).
 *
 * UM sistema responsivo, mesma árvore semântica:
 * - mobile: grid-cols-1 (avatar → identidade → stats, reflow vertical);
 * - desktop: lg:grid-cols-[auto_minmax(0,1fr)_auto] (avatar | identidade | stats).
 *
 * Capa Cinematic Aurora decorativa (sem upload nesta etapa).
 * Avatar sobrepõe a capa; sem foto → fallback de iniciais (nunca img quebrada).
 */

import ProfileTabs from "./ProfileTabs.astro";

interface Props {
  displayName: string;
  username: string | null;
  bio: string | null;
  avatarUrl: string | null;
  /** Contador real da Minha Lista. NULL = indisponível (tabela pré-migration). */
  watchlistCount: number | null;
  /** Contador real de Assistidos. NULL = indisponível (tabela pré-migration). */
  watchedCount?: number | null;
  /** Contador real de Avaliações. NULL = indisponível (tabela pré-migration). */
  ratingsCount?: number | null;
  activeTab: "overview" | "about" | "list" | "watched" | "ratings";
}

const { displayName, username, bio, avatarUrl, watchlistCount, watchedCount = null, ratingsCount = null, activeTab } =
  Astro.props;

/** Iniciais elegantes para o fallback (ex.: "José Henrique" → "JH"). */
function initials(name: string): string {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  const first = parts[0]?.charAt(0) ?? "";
  const last = parts.length > 1 ? (parts[parts.length - 1]?.charAt(0) ?? "") : "";
  return (first + last).toUpperCase() || "?";
}

const fallback = initials(displayName || "C");

function countLabel(count: number | null): string {
  if (count === null) return "—";
  return String(count);
}
---

<div>
  {/* Capa decorativa Cinematic Aurora: violeta + azul profundo + magenta discreto. */}
  <div
    aria-hidden="true"
    class="cinevee-profile-cover relative h-36 overflow-hidden sm:h-44 lg:h-52"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-violet-950 via-[#141b3d] to-[#2a1030]"></div>
    <div class="absolute -left-16 -top-24 h-64 w-64 rounded-full bg-violet-600/30 blur-3xl"></div>
    <div class="absolute right-[-4rem] top-[-6rem] h-72 w-72 rounded-full bg-blue-600/25 blur-3xl"></div>
    <div class="absolute bottom-[-7rem] left-1/3 h-56 w-96 rounded-full bg-fuchsia-600/15 blur-3xl"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-base-100 via-transparent to-transparent"></div>
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    {/* Hero: mesma hierarquia em todas as telas; desktop distribui em 3 colunas. */}
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[auto_minmax(0,1fr)_auto] lg:items-end lg:gap-10">
      {/* Avatar sobre a capa: overlap intencional via translate (não altera
         o layout — evita que a margem negativa colapse a linha do grid e
         puxe nome/textos para baixo do avatar/capa no mobile). */}
      <div class="relative z-10 -translate-y-12 sm:-mt-14 sm:translate-y-0 lg:-mt-16">
        {
          avatarUrl ? (
            <img
              src={avatarUrl}
              alt={`Foto de ${displayName}`}
              width="256"
              height="256"
              loading="eager"
              class="h-24 w-24 rounded-full border-2 border-base-100 object-cover shadow-xl sm:h-28 sm:w-28 lg:h-32 lg:w-32"
            />
          ) : (
            <div
              aria-hidden="true"
              class="flex h-24 w-24 items-center justify-center rounded-full border-2 border-base-100 bg-gradient-to-br from-violet-700 via-indigo-700 to-blue-800 text-3xl font-extrabold text-white shadow-xl sm:h-28 sm:w-28 lg:h-32 lg:w-32 lg:text-4xl"
            >
              {fallback}
            </div>
          )
        }
      </div>

      {/* Identidade + bio + editar. */}
      <div class="min-w-0 lg:pb-1">
        <h1 class="truncate text-2xl font-extrabold tracking-tight sm:text-3xl">
          {displayName}
        </h1>
        {
          username ? (
            <p class="mt-1 text-sm text-base-content/60">@{username}</p>
          ) : (
            <p class="mt-1 text-sm">
              <a
                href="/perfil/editar"
                class="text-base-content/50 underline-offset-4 hover:text-primary hover:underline"
              >
                Adicionar @usuário
              </a>
            </p>
          )
        }
        {
          bio ? (
            <p class="mt-3 max-w-prose break-words text-pretty text-sm leading-6 text-base-content/75 sm:text-base">
              {bio}
            </p>
          ) : (
            <p class="mt-3 text-sm text-base-content/45">
              <a
                href="/perfil/editar"
                class="underline-offset-4 hover:text-primary hover:underline"
              >
                Adicione uma bio ao seu perfil.
              </a>
            </p>
          )
        }
        <p class="mt-4">
          <a
            href="/perfil/editar"
            class="btn btn-outline min-h-12 rounded-full px-6 text-sm font-semibold"
          >
            Editar perfil
          </a>
        </p>
      </div>

      {/* Stats reais (sem inventar números; NULL = tabela pré-migration). */}
      <dl
        aria-label="Estatísticas do perfil"
        class="grid grid-cols-3 gap-2 rounded-2xl border border-base-300/60 bg-base-200/40 px-2 py-4 sm:gap-4 sm:px-6 lg:min-w-72 lg:gap-6"
      >
        <div class="flex min-h-12 flex-col items-center justify-center text-center">
          <dt class="order-2 mt-1 text-xs text-base-content/60">Minha Lista</dt>
          <dd class="order-1 text-xl font-extrabold sm:text-2xl">
            <a
              href="/perfil/lista"
              aria-label={`Minha Lista, ${watchlistCount === 1 ? "1 título salvo" : watchlistCount === null ? "contagem indisponível" : `${watchlistCount} títulos salvos`}`}
              class="hover:text-primary"
            >
              {countLabel(watchlistCount)}
            </a>
          </dd>
        </div>
        <div class="flex min-h-12 flex-col items-center justify-center text-center">
          <dt class="order-2 mt-1 text-xs text-base-content/60">Assistidos</dt>
          <dd class="order-1 text-xl font-extrabold sm:text-2xl">
            <a
              href="/perfil/assistidos"
              aria-label={`Assistidos, ${watchedCount === 1 ? "1 título assistido" : watchedCount === null ? "contagem indisponível" : `${watchedCount} títulos assistidos`}`}
              class="hover:text-primary"
            >
              {countLabel(watchedCount)}
            </a>
          </dd>
        </div>
        <div class="flex min-h-12 flex-col items-center justify-center text-center">
          <dt class="order-2 mt-1 text-xs text-base-content/60">Avaliações</dt>
          <dd class="order-1 text-xl font-extrabold sm:text-2xl">
            <a
              href="/perfil/avaliacoes"
              aria-label={`Avaliações, ${ratingsCount === 1 ? "1 título avaliado" : ratingsCount === null ? "contagem indisponível" : `${ratingsCount} títulos avaliados`}`}
              class="hover:text-primary"
            >
              {countLabel(ratingsCount)}
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <ProfileTabs active={activeTab} />

    <div class="pb-32">
      <slot />
    </div>
  </div>
</div>
