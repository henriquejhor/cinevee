---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import AppHeader from "../components/navigation/AppHeader.astro";
import DiscoveryProgress from "../components/discovery/DiscoveryProgress.astro";
import DiscoveryOptionTemplate from "../components/discovery/DiscoveryOptionTemplate.astro";
import DiscoveryIcon from "../components/discovery/DiscoveryIcon.astro";

// Shell estático (prerender): o questionário roda no navegador com
// estado em localStorage. Sem Gemini/Supabase nesta etapa.
export const prerender = true;
---

<Layout
  title="Descobrir — CineVee"
  description="Responda o questionário e descubra o que assistir."
>
  <AppHeader />
  <main class="cinevee-aurora mx-auto w-full max-w-3xl px-4 pb-32 pt-6 sm:px-8">
    <DiscoveryProgress />

    <div
      data-discovery-stage
      data-view="step"
      class="transition-opacity transition-transform duration-200"
    >
      <p
        data-eyebrow-row
        style="display: none"
        class="mt-8 items-center gap-1.5 text-xs font-bold uppercase tracking-[0.22em] text-primary"
      >
        <span data-eyebrow-icon style="display: none" class="inline-flex">
          <DiscoveryIcon name="sparkles" class="discovery-icon--sm" />
        </span>
        <span data-discovery-eyebrow></span>
      </p>
      <h1
        data-discovery-question
        tabindex="-1"
        class="mt-3 max-w-[22ch] text-balance text-3xl font-extrabold tracking-tight focus:outline-none sm:text-4xl"
      >
        O que você quer assistir?
      </h1>
      <p data-discovery-hint class="mt-2 max-w-[52ch] text-pretty text-base text-base-content/70"></p>
      <p data-genre-count class="mt-2 text-xs font-medium text-base-content/50" style="display: none"></p>

      <div data-discovery-options class="mt-7 flex flex-col gap-3"></div>

      <button
        type="button"
        data-discovery-continue
        style="display: none"
        class="btn btn-primary mt-7 min-h-13 w-full rounded-full text-base"
      >
        Continuar
      </button>
    </div>

    <p data-discovery-status role="status" class="sr-only"></p>

    <DiscoveryOptionTemplate />
  </main>
</Layout>

<script>
  import { startDiscoveryFlow } from "../lib/discovery/flow";

  startDiscoveryFlow();
</script>
