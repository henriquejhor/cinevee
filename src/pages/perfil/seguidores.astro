---
/**
 * /perfil/seguidores — management privada dos próprios seguidores
 * (Etapa 23). Protegida por login. Inclui followers private (relação
 * direta). Ações por linha: Remover (sem block) e Bloquear (encerra
 * tudo). Confirmação inline em 2 cliques, sem window.confirm.
 */
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import AppHeader from "../../components/navigation/AppHeader.astro";
import { getUserProfile } from "../../lib/profile/service";
import {
  getBlocksSession,
  getMyFollowersPage,
} from "../../lib/blocks/service";
import { BLOCKS_PAGE_SIZE } from "../../lib/blocks/types";

export const prerender = false;

const { user } = await getUserProfile(Astro.request, Astro.cookies);

if (!user) {
  return Astro.redirect("/entrar?next=/perfil/seguidores", 303);
}

const session = await getBlocksSession(Astro.request, Astro.cookies);

let loadError = false;
let items: Awaited<ReturnType<typeof getMyFollowersPage>>["items"] = [];
let hasMore = false;

if (session) {
  try {
    const page = await getMyFollowersPage(session, 1, BLOCKS_PAGE_SIZE);
    items = page.items;
    hasMore = page.hasMore;
  } catch {
    loadError = true;
  }
} else {
  loadError = true;
}

function initials(name: string | null): string {
  const parts = (name ?? "").trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "?";
  const first = parts[0]?.charAt(0) ?? "";
  const last = parts.length > 1 ? (parts[parts.length - 1]?.charAt(0) ?? "") : "";
  return (first + last).toUpperCase() || "?";
}

function relativeTime(iso: string | null): string {
  if (!iso) return "";
  const then = Date.parse(iso);
  if (Number.isNaN(then)) return "";
  const diff = Math.max(0, Math.floor((Date.now() - then) / 1000));
  if (diff < 60) return "agora mesmo";
  const minutes = Math.floor(diff / 60);
  if (minutes < 60) return `há ${minutes} min`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `há ${hours} h`;
  const days = Math.floor(hours / 24);
  if (days === 1) return "há 1 dia";
  if (days < 7) return `há ${days} dias`;
  const weeks = Math.floor(days / 7);
  if (weeks < 5) return weeks === 1 ? "há 1 sem" : `há ${weeks} sem`;
  const months = Math.floor(days / 30);
  if (months < 12) return months === 1 ? "há 1 mês" : `há ${months} meses`;
  const years = Math.floor(days / 365);
  return years === 1 ? "há 1 ano" : `há ${years} anos`;
}
---

<Layout title="Meus seguidores — CineVee" description="Gerencie quem segue você." noindex>
  <AppHeader />
  <main class="mx-auto w-full max-w-2xl px-4 pb-32 pt-10 sm:px-6 sm:pt-14">
    <nav aria-label="Navegação" class="mb-6">
      <a
        href="/perfil"
        class="inline-flex min-h-12 min-w-12 items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-base-content/70 hover:bg-base-200 hover:text-base-content"
      >
        Voltar ao perfil
      </a>
    </nav>

    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Sua conta</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight">Meus seguidores</h1>
    <p class="mt-1 text-sm text-base-content/60">
      Remova quem você não quer por perto — sem bloquear — ou bloqueie para encerrar todo contato.
    </p>

    <p id="followers-status" role="status" aria-live="polite" style="display: none" class="mt-4 rounded-2xl border px-4 py-3 text-sm"></p>

    {
      loadError ? (
        <div class="mt-6 rounded-2xl border border-base-300 bg-base-200/40 px-5 py-8 text-center">
          <p class="text-sm font-semibold">Não foi possível carregar seus seguidores agora.</p>
          <a href="/perfil/seguidores" class="btn btn-primary mt-4 min-h-12 rounded-full px-8 text-sm font-semibold">
            Tentar novamente
          </a>
        </div>
      ) : items.length === 0 ? (
        <div class="mt-6 rounded-2xl border border-base-300/60 bg-base-200/40 px-5 py-8 text-center">
          <p class="text-sm font-semibold">Nenhum seguidor ainda.</p>
          <p class="mt-1 text-sm text-base-content/60">
            Quando alguém seguir você, essa pessoa aparece aqui.
          </p>
        </div>
      ) : (
        <ul id="followers-list" aria-label="Meus seguidores" class="mt-6 flex flex-col gap-3">
          {
            items.map((item) => {
              const name = item.displayName?.trim() || (item.username ? `@${item.username}` : "Seguidor");
              return (
                <li
                  data-follow-id={item.followId}
                  class="rounded-2xl border border-base-300/60 bg-base-200/40 p-3"
                >
                  <div class="flex items-center gap-3">
                    <span
                      aria-hidden="true"
                      class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-base-300 text-sm font-extrabold text-base-content/60"
                    >
                      {initials(item.displayName ?? item.username)}
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="truncate break-words text-sm font-semibold leading-snug">{name}</p>
                      <p class="mt-0.5 text-xs text-base-content/60">
                        {item.username && <span class="mr-2">@{item.username}</span>}
                        {item.followedAt && <span>Segue você {relativeTime(item.followedAt)}</span>}
                        {!item.isPublic && <span class="ml-2 rounded-full border border-base-300/70 px-2 py-0.5">privado</span>}
                      </p>
                    </div>
                  </div>
                  <div class="mt-2 flex flex-wrap gap-2 pl-15">
                    <button
                      type="button"
                      data-role="follower-remove"
                      data-follow-id={item.followId}
                      data-armed="false"
                      aria-label="Remover seguidor"
                      class="btn btn-outline min-h-12 rounded-full px-6 text-sm"
                    >
                      Remover
                    </button>
                    <button
                      type="button"
                      data-role="follower-block"
                      data-follow-id={item.followId}
                      data-armed="false"
                      aria-label="Bloquear seguidor"
                      class="btn btn-ghost min-h-12 rounded-full border border-base-300/70 px-6 text-sm text-error/70"
                    >
                      Bloquear
                    </button>
                  </div>
                  <p data-role="follower-note" role="status" class="mt-2 hidden text-xs leading-5 text-base-content/60" />
                </li>
              );
            })
          }
        </ul>
      )
    }
    {
      hasMore && (
        <div class="mt-6 flex flex-col items-center gap-3">
          <button
            id="followers-more"
            type="button"
            data-next-page="2"
            class="btn btn-outline min-h-12 rounded-full px-10"
          >
            Carregar mais
          </button>
          <p id="followers-more-status" role="status" class="min-h-5 text-xs text-base-content/60" />
        </div>
      )
    }
  </main>
</Layout>

<script>
  // Gestão de seguidores: remover (2 cliques) e bloquear (2 cliques).
  // Delegation única; sem listeners por linha.
  (function () {
    var list = document.getElementById("followers-list") as HTMLElement | null;
    var more = document.getElementById("followers-more") as HTMLButtonElement | null;
    var moreStatus = document.getElementById("followers-more-status") as HTMLElement | null;
    var status = document.getElementById("followers-status") as HTMLElement | null;

    function announce(message: string, ok: boolean) {
      if (!status) return;
      status.textContent = message;
      status.style.display = "";
      status.className =
        "mt-4 rounded-2xl border px-4 py-3 text-sm " +
        (ok ? "border-success/40 bg-success/10" : "border-error/40 bg-error/10");
    }

    function noteFor(card: HTMLElement): HTMLElement | null {
      var note = card.querySelector('[data-role="follower-note"]');
      return note instanceof HTMLElement ? note : null;
    }

    function postJson(path: string, body: Record<string, unknown>): Promise<Response> {
      return fetch(path, {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
    }

    function goLogin() {
      window.location.href = "/entrar?next=" + encodeURIComponent("/perfil/seguidores");
    }

    function handleRemove(button: HTMLButtonElement, card: HTMLElement, followId: number) {
      if (button.getAttribute("data-armed") !== "true") {
        button.setAttribute("data-armed", "true");
        button.textContent = "Confirmar remoção";
        var note = noteFor(card);
        if (note) {
          note.textContent = "Essa pessoa deixará de seguir você, mas poderá seguir novamente no futuro.";
          note.classList.remove("hidden");
        }
        return;
      }
      button.setAttribute("disabled", "");
      button.textContent = "Removendo…";
      postJson("/api/followers/remove", { followId: followId })
        .then(function (res) {
          if (res.status === 401) {
            goLogin();
            return null;
          }
          if (!res.ok) throw new Error("HTTP " + res.status);
          return res.json();
        })
        .then(function (data: unknown) {
          if (!data || typeof data !== "object") return;
          card.remove();
          announce("Seguidor removido.", true);
        })
        .catch(function () {
          button.removeAttribute("disabled");
          button.setAttribute("data-armed", "false");
          button.textContent = "Remover";
          announce("Não foi possível remover este seguidor.", false);
        });
    }

    function handleBlock(button: HTMLButtonElement, card: HTMLElement, followId: number) {
      if (button.getAttribute("data-armed") !== "true") {
        button.setAttribute("data-armed", "true");
        button.textContent = "Confirmar bloqueio";
        var note = noteFor(card);
        if (note) {
          note.textContent =
            "Vocês deixarão de se seguir e não poderão encontrar o perfil um do outro " +
            "nem iniciar novas interações enquanto o bloqueio estiver ativo.";
          note.classList.remove("hidden");
        }
        return;
      }
      button.setAttribute("disabled", "");
      button.textContent = "Bloqueando…";
      postJson("/api/blocks/by-follower", { followId: followId })
        .then(function (res) {
          if (res.status === 401) {
            goLogin();
            return null;
          }
          if (!res.ok) throw new Error("HTTP " + res.status);
          return res.json();
        })
        .then(function (data: unknown) {
          if (!data || typeof data !== "object") return;
          card.remove();
          announce("Usuário bloqueado. Veja em Usuários bloqueados.", true);
        })
        .catch(function () {
          button.removeAttribute("disabled");
          button.setAttribute("data-armed", "false");
          button.textContent = "Bloquear";
          announce("Não foi possível bloquear este usuário.", false);
        });
    }

    document.addEventListener("click", function (event) {
      var target = event.target;
      if (!(target instanceof Element)) return;
      var remove = target.closest('[data-role="follower-remove"]');
      if (remove instanceof HTMLButtonElement) {
        var cardR = remove.closest("[data-follow-id]");
        var fidR = Number(remove.getAttribute("data-follow-id"));
        if (cardR instanceof HTMLElement && Number.isSafeInteger(fidR) && fidR >= 1) {
          handleRemove(remove, cardR, fidR);
        }
        return;
      }
      var block = target.closest('[data-role="follower-block"]');
      if (block instanceof HTMLButtonElement) {
        var cardB = block.closest("[data-follow-id]");
        var fidB = Number(block.getAttribute("data-follow-id"));
        if (cardB instanceof HTMLElement && Number.isSafeInteger(fidB) && fidB >= 1) {
          handleBlock(block, cardB, fidB);
        }
      }
    });

    if (more instanceof HTMLButtonElement && list) {
      more.addEventListener("click", function () {
        if (!(more instanceof HTMLButtonElement) || more.hasAttribute("disabled")) return;
        var next = Number(more.getAttribute("data-next-page") || "2");
        if (!Number.isSafeInteger(next) || next < 1) return;
        more.setAttribute("disabled", "");
        if (moreStatus) moreStatus.textContent = "Carregando…";
        fetch("/api/followers/mine?page=" + next + "&limit=24", { credentials: "same-origin" })
          .then(function (res) {
            if (!res.ok) throw new Error("HTTP " + res.status);
            return res.json();
          })
          .then(function (data: unknown) {
            if (!data || typeof data !== "object") throw new Error("payload inválido");
            if (!(list instanceof HTMLElement)) throw new Error("lista ausente");
            var body = data as Record<string, unknown>;
            var rawItems = Array.isArray(body.items) ? body.items : [];
            var known = new Set<number>();
            var existing = list.querySelectorAll("[data-follow-id]");
            for (var i = 0; i < existing.length; i++) {
              var knownId = Number(existing[i].getAttribute("data-follow-id"));
              if (Number.isSafeInteger(knownId)) known.add(knownId);
            }
            for (var j = 0; j < rawItems.length; j++) {
              var raw = rawItems[j];
              if (typeof raw !== "object" || raw === null) continue;
              var record = raw as Record<string, unknown>;
              var id = record.followId;
              if (typeof id !== "number" || !Number.isSafeInteger(id) || known.has(id)) continue;
              known.add(id);
              var li = document.createElement("li");
              li.setAttribute("data-follow-id", String(id));
              li.className = "rounded-2xl border border-base-300/60 bg-base-200/40 p-3";
              var shown =
                typeof record.displayName === "string" && record.displayName.trim()
                  ? record.displayName.trim()
                  : typeof record.username === "string" && record.username
                    ? "@" + record.username
                    : "Seguidor";
              var row = document.createElement("div");
              row.className = "flex items-center gap-3";
              var avatar = document.createElement("span");
              avatar.setAttribute("aria-hidden", "true");
              avatar.className = "flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-base-300 text-sm font-extrabold text-base-content/60";
              avatar.textContent = "?";
              row.appendChild(avatar);
              var box = document.createElement("div");
              box.className = "min-w-0 flex-1";
              var name = document.createElement("p");
              name.className = "truncate break-words text-sm font-semibold leading-snug";
              name.textContent = shown;
              box.appendChild(name);
              row.appendChild(box);
              li.appendChild(row);
              var actions = document.createElement("div");
              actions.className = "mt-2 flex flex-wrap gap-2 pl-15";
              var rm = document.createElement("button");
              rm.setAttribute("type", "button");
              rm.setAttribute("data-role", "follower-remove");
              rm.setAttribute("data-follow-id", String(id));
              rm.setAttribute("data-armed", "false");
              rm.setAttribute("aria-label", "Remover seguidor");
              rm.className = "btn btn-outline min-h-12 rounded-full px-6 text-sm";
              rm.textContent = "Remover";
              var bl = document.createElement("button");
              bl.setAttribute("type", "button");
              bl.setAttribute("data-role", "follower-block");
              bl.setAttribute("data-follow-id", String(id));
              bl.setAttribute("data-armed", "false");
              bl.setAttribute("aria-label", "Bloquear seguidor");
              bl.className = "btn btn-ghost min-h-12 rounded-full border border-base-300/70 px-6 text-sm text-error/70";
              bl.textContent = "Bloquear";
              actions.appendChild(rm);
              actions.appendChild(bl);
              li.appendChild(actions);
              var note = document.createElement("p");
              note.setAttribute("data-role", "follower-note");
              note.setAttribute("role", "status");
              note.className = "mt-2 hidden text-xs leading-5 text-base-content/60";
              li.appendChild(note);
              if (list instanceof HTMLElement) list.appendChild(li);
            }
            if (!(more instanceof HTMLButtonElement)) return;
            if (body.hasMore === true) {
              more.setAttribute("data-next-page", String(next + 1));
              more.removeAttribute("disabled");
              if (moreStatus) moreStatus.textContent = "";
            } else {
              more.remove();
              if (moreStatus) moreStatus.textContent = "Você viu todos os seguidores.";
            }
          })
          .catch(function () {
            if (more instanceof HTMLButtonElement) more.removeAttribute("disabled");
            if (moreStatus) moreStatus.textContent = "Não foi possível carregar. Tente de novo.";
          });
      });
    }
  })();
</script>
